PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/checkout_db

# Receiver Addresses (Your wallets where funds are sent)
RECEIVER_ADDRESS=0x98F63eDf950db3bD3cE6d590D4E0B39fdCC20Cf9
SOLANA_RECEIVER=HQbKDL2VQDWTD9rKTg5HGC9VeEpMubKeT1Lkorjr5YzR
TRON_RECEIVER=TNMAmgG22RUkMgr9a8tHm1LuxDzZAfsmYT

# EVM Relayer Private Keys (Fund these just-in-time with exact gas amount)
ETH_RELAYER_KEY=0x...
BASE_RELAYER_KEY=0x...
POLYGON_RELAYER_KEY=0x...
ARBITRUM_RELAYER_KEY=0x...
BNB_RELAYER_KEY=0x...
OPTIMISM_RELAYER_KEY=0x...

# EVM RPC URLs (Get from Alchemy, Infura, or other providers)
ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BNB_RPC=https://bsc-dataseed.bnbchain.org
OPTIMISM_RPC=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Solana Configuration
SOLANA_RELAYER_PUBKEY=YourSolanaRelayerPublicKey

# Tron Configuration
TRON_RELAYER_KEY=YourTronPrivateKey
TRON_RELAYER_ADDRESS=YourTronAddress

# Admin Dashboard URL
ADMIN_URL=http://localhost:3000/admin-ui
