{
  "version": 2,
  "env": {
    "BACKEND_URL": "https://checkout-api-wkyo.onrender.com"
  },
  "routes": [
    {
      "src": "/(.*\\.(js|css|gif|jpg|jpeg|png|ico|svg|woff|woff2|eot|ttf))$",
      "dest": "/frontend/$1"
    },
    {
      "src": "/.*",
      "dest": "/frontend/index.html"
    }
  ]
}
